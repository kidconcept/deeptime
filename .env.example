# DeepTime Environment Configuration
# Copy this file to .env and update with your values
# .env is gitignored and should never be committed

# Google Cloud Project Configuration
PROJECT_ID=your-project-id
REGION=us-central1

# Cloud Storage
BUCKET_NAME=your-bucket-name

# TiTiler Service (automatically set by deploy.sh)
TITILER_URL=https://titiler-xxxxx-uc.a.run.app

# Service Account (automatically derived from PROJECT_ID)
TITILER_SA_EMAIL=titiler-sa@your-project-id.iam.gserviceaccount.com

# Test COG for validation (update with your test file)
COG_GCS_URI=gs://your-bucket-name/your-test-file.tif
